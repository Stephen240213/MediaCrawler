# Copy outside the checkout (or into ignored .runtime/), restrict file permissions.
# These settings identify your Access application; never paste actual tokens here.
MC_ACCESS_TEAM=your-team
MC_ACCESS_AUD=replace-with-access-application-audience
MC_PUBLIC_ORIGIN=https://crawler.example.com
MC_OPERATORS=you@example.com
MC_VIEWERS=reader@example.com
# Optional ABSOLUTE paths; omit to retain existing collection/workbench locations.
# MC_RUNTIME_DIR=/absolute/path/MediaCrawler/.runtime
# SQLITE_DB_PATH=/absolute/path/MediaCrawler/database/sqlite_tables.db
# Optional extra directories containing uv and Node (colon on macOS/Linux; semicolon on Windows).
# MC_TOOL_PATH=/Users/you/.local/bin:/opt/homebrew/bin
UV_FROZEN=1
